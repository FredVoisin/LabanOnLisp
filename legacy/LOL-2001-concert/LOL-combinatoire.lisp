(in-package :lol)(setf *GENSYM-COUNTER* 1)(defmethod full-jam ((situation situation))  (let ((sets '())        (seta '())        (temp '())        (r '()))    (dotimes (n (length (body situation)))      (setf temp '())      (push (nth n (body situation)) temp)      (push (nth n (support situation)) temp)      (push (nth n (direction situation)) temp)      (push (nth n (level situation)) temp)      (push (nth n (rotation situation)) temp)      (push (nth n (distance situation)) temp)      (push (nth n (flexion situation)) temp)      (push (nth n (curve situation)) temp)      (push (nth n (contact situation)) temp)      (push (nth n (address situation)) temp)      (push (reverse temp) sets))    (setf sets (reverse sets))        (dotimes (n (length sets))      (setf (first (nth n sets)) (list (first (nth n sets))))      (if (w!-p (nth n (support-freedom situation)))        (setf (second (nth n sets)) (list (second (nth n sets))))        (setf (second (nth n sets)) *support-set*)        )      (if (w!-p (nth n (direction-freedom situation)))        (setf (third (nth n sets)) (list (third (nth n sets))))        (setf (third (nth n sets)) *direction-set*)        )      (if (w!-p (nth n (level-freedom situation)))        (setf (fourth (nth n sets)) (list (fourth (nth n sets))))        (setf (fourth (nth n sets)) *level-set*)        )      (if (w!-p (nth n (rotation-freedom situation)))        (setf (fifth (nth n sets)) (list (fifth (nth n sets))))        (setf (fifth (nth n sets)) *rotation-set*)        )      (if (w!-p (nth n (distance-freedom situation)))        (setf (sixth (nth n sets)) (list (sixth (nth n sets))))        (setf (sixth (nth n sets)) *distance-set*)        )      (if (w!-p (nth n (flexion-freedom situation)))        (setf (seventh (nth n sets)) (list (seventh (nth n sets))))        (setf (seventh (nth n sets)) *flexion-set*)        )      (if (w!-p (nth n (curve-freedom situation)))        (setf (eighth (nth n sets)) (list (eighth (nth n sets))))        (setf (eighth (nth n sets)) *curve-set*)        )      (if (w!-p (nth n (contact-freedom situation)))        (setf (ninth (nth n sets)) (list (ninth (nth n sets))))        (setf (ninth (nth n sets)) *contact-set*)        )      (if (w!-p (nth n (address-freedom situation)))        (setf (tenth (nth n sets)) (list (tenth (nth n sets))))        (setf (tenth (nth n sets)) *address-set*)        ))        (setf seta (mapcar #'(lambda (bodypart-param)                                                      (apply #'cartesian bodypart-param))                       sets))        (dolist (l seta)      (push (mapcar #'(lambda (x)                        (make-instance 'bodypart                          :partname (first x)                          :support (second x)                          :direction (third x)                          :level (fourth x)                          :rotation (fifth x)                          :distance (sixth x)                          :flexion (seventh x)                          :curve (eighth x)                          :contact (ninth x)                          :address (tenth x)))                    l) r))    (setf r (apply #'cartesian (reverse r)))    (mapcar #'(lambda (b)                (make-situation                 :name (situation-name situation)                 :ancestor (situation-name situation)                 :body (mapcar #'partname b)                 :support (mapcar #'support b)                 :direction (mapcar #'direction b)                 :level (mapcar #'level b)                 :rotation (mapcar #'rotation b)                 :distance (mapcar #'distance b)                 :flexion (mapcar #'flexion b)                 :curve (mapcar #'curve b)                 :contact (mapcar #'contact b)                 :address (mapcar #'address b)                 :return t))            r)    ))#|(describe SITUATION-1081)(mapcar #'describe (full-jam SITUATION-1081))|#;****************;filtre(defun test1 (object criterium c-value descriptor function d-value)  (when (or (equalp function 'equalp)            (equalp function '=))    (setf function 'equalp))  (let* ((criterium-list (funcall (symbol-function criterium) object))         (pos-criterium (position  c-value criterium-list :test #'equalp)))    (if pos-criterium      (when (funcall (symbol-function function)                     (nth pos-criterium (funcall (symbol-function descriptor) object))                     d-value)        (values object))      (format *standard-output* "No ~S found in ~S of ~S.~%" c-value criterium object) )))#|(support zz)(test1 zz 'body "a" 'support 'equal 'yes)(test1 zz 'body "a" 'support '= 'yes)(test1 zz 'body "b" 'support 'equal 'no)(test1 zz 'support 'no 'support 'equal 'no)(and (test1 zz 'body "a" 'support 'equal 'yes)    (test1 zz 'body "b" 'support 'equal 'no))(or (test1 zz 'body "a" 'support 'equal 'no)    (test1 zz 'body "b" 'support 'equal 'yes))|#(defmethod test ((object situation) (criterium t) (c-value t) (descriptor t) (function t) (d-value t))  (test1 object criterium c-value descriptor function d-value))(defmethod test ((object list) (criterium t) (c-value t) (descriptor t) (function t) (d-value t))   (remove 'nil (mapcar #'(lambda (o)                            (test o criterium c-value descriptor function d-value))                        (mapcar #'eval object))))(defmethod test ((object situation) (criterium t) (c-value list) (descriptor t) (function t) (d-value t))   (let ((res (mapcar #'(lambda (c)                          (test1 object criterium c descriptor function d-value))                      c-value)))     (eval `(and ,.res))))#|(direction zz)(test zz 'body '("a" "b") 'support '= 'yes)(test zz 'body '("a" "b") 'direction '> 0)|#(defmethod filtre-n ((situation situation) (dimension t) (critere t) (n integer) &key (test '=))  (let* ((param (funcall dimension situation))         (count (count critere param :test #'equalp)))    (when (funcall test count n)      (situation-name situation))))(defmethod filtre-n ((situation list) (dimension t) (critere t) (n integer) &key (test #'equalp))  (remove 'nil          (mapcar #'(lambda (s) (filtre-n s dimension critere n :test test)) situation)))(defmethod filtre-n ((situation symbol) (dimension t) (critere t) (n integer) &key (test #'equalp))  (filtre-n (eval situation) dimension critere n :test test))(defmethod filtre-n ((situation situation) (dimension t) (critere t) (n list) &key (test '=))  (remove 'nil  (mapcar #'(lambda (i) (filtre-n situation dimension critere i :test test)) n)))(defmethod filtre-n ((situation symbol) (dimension t) (critere t) (n list) &key (test '=))  (remove 'nil  (mapcar #'(lambda (i) (filtre-n (eval situation) dimension critere i :test test)) n)))(defmethod filtre-n ((situation list) (dimension t) (critere t) (n list) &key (test '=))  (apply #'append  (remove 'nil  (mapcar #'(lambda (s) (filtre-n s dimension critere n :test test)) situation))))#|(filtre-n situation-y-567 'support 'yes '(1 2) :test '= 1 :test '>)(filtre-n c1 'support 'yes '(1 2) :test '>)(filtre-n c1 'support 'yes '(1 2) :test '>)|#