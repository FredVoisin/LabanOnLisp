bda (a)               (cond ((> a 250)                     (round (* a 2)))                    ((< a 250)                     (round (/ a 2)))                    (t a))) x))(defun courbe1 (start end)  (let ((r (list start)))    (loop for i from 0          until (> (round (* (car r) 1.5)) end)          do          (push (round (* (car r) 1.5)) r))    (reverse r)))(defun geste (rules)  (meaning rules))#|(defun gammeparton (start end)  (loop for i from start to end step 200        collect i))|#(use *music2*)#|(meaning '(quarte twice))(meaning '(quarte and seconde desc twice))(meaning '(quarte and seconde desc))(meaning '(seconde desc))(meaning '(c3 and db3 and f#3))(meaning '(c3 to b3 without f#3 ))(meaning '([ c3 to b3 without f#3 ] reversed))(meaning '(c3 to b3 without f#3 twice))(all-parses '(c3 to b3 without f#3 twice))(meaning '(do and f#3))(meaning '(f#3 and do))(meaning '(do without c3))(meaning '(quarte and seconde))(meaning '(8 << 80 step 5))(meaning '(8 << 80 by 5))(meaning '(c3 to b3 by seconde twice))(geste '(c3 to b3 by seconde repeat 3))(geste '(c3 to b3 by ton repeat 3))(geste '(c3 to b3 by quart repeat 3))(geste '(pp and ff repeat 2))(geste '(pp cresc ff))(geste '(pp cresc ff then ff decresc p twice))(geste '(pp))(meaning '(short then long))(meaning '(very short then long))(meaning '( slow ))(meaning '(very slow))(meaning '( fast to slow step 10))(meaning '(very fast then slow))(meaning '(very fast to slow step 20))(meaning '(very fast to very slow step 20))(meaning '(very fast then very slow))|#