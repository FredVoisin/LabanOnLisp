(in-package :lol)(require 'scrolling-windows.lisp)(defun seqstring-to-liststrings (string)"Converts a string into a list of strings - words - separated by space character."  (let ((listofstrings ()) (lengths (pos-to-lengths (posofspaces string)))        (pos (append (list 0) (mapcar #'(lambda (x) (1+ x)) (butlast (posofspaces string))))))    (dotimes (l (length lengths) (nreverse listofstrings))      (let ((str (make-string (nth l lengths) :initial-element #\Space)))       (dotimes (n (nth l lengths) (push str listofstrings))         (setf (elt str n) (elt string (+ n (nth l pos)))))))))(defun posofspaces (string)  (let ((pos ()))    (dotimes (n (length string) (nreverse (append (list (length string)) pos)))      (when (equal (elt string n) #\Space)        (push n pos)))))(defun pos-to-lengths (positions)  (let ((lengths ()))    (dotimes (n (1- (length positions))                (append (list (car positions)) (nreverse lengths)))      (push (- (nth (1+ n) positions) (nth n positions) 1) lengths))))#|(seqstring-to-liststrings "ab cd efg")|#(defun set-bodyparts ()  (seqstring-to-liststrings   (get-string-from-user "Please, enter your Body Parts."                         :size #@(400 100)                         :position :centered                         :window-title "SET BODY PARTS")))(defmethod make-static-text ((text string) (h integer) (v integer) &key color size)  (let ((view (make-dialog-item 'static-text-dialog-item                                 #@(3 9)                                 (if size size #@(90 16))                                text                                'nil                                :part-color-list (if color                                                   (list :body color)                                                   '(:body 10461087)))))    (set-view-position view h v)    view))(defmethod make-static-text ((text list) (h list) (v list) &key color size)  (mapcar #'(lambda (txt x y) (make-static-text txt x y :color color :size size)) text h v))(defmethod make-static-text ((text list) (h list) (v integer) &key color size)  (mapcar #'(lambda (txt x) (make-static-text txt x v :color color :size size)) text h))#|(make-static-text "aa" 10 10)(make-static-text "aa" 10 10 :color nil)(make-static-text "aa" 10 10 :color 14671839)(make-static-text '("aa" "bb") '(10 10) '(10 20) :color 14671839)(make-static-text '("aa" "bb") '(10 20) 10 :color 14671839)|#(defmethod make-editable-text ((text string) (h integer) (v integer) &key color)  (let ((view (make-dialog-item 'editable-text-dialog-item                                #@(3 3)                                 #@(40 19)                                 text                                 'nil                                :part-color-list (if color                                                   (list :body color)                                                   (list :body 10461087)))))    (set-view-position view h v)    view))(defmethod make-editable-text  ((text list) (h list) (v list) &key color)  (mapcar #'(lambda (txt x y) (make-editable-text txt x y :color color)) text h v))(defmethod make-editable-text ((text list) (h list) (v integer) &key color)  (mapcar #'(lambda (txt x) (make-editable-text txt x v :color color)) text h))(defun make-check-box (text h v &optional checked)  (let ((chekbox  (make-dialog-item 'check-box-dialog-item                    #@(3 3)                    #@(40 12)                    text                    'nil                    :check-box-checked-p checked                    :view-font '("Chicago" 10 :SRCCOPY ))))        (set-view-position chekbox h v)    chekbox))(defun make-bodypart-views (body-part h &optional data &key back-color edit-color)  (list   (make-static-text body-part 10 (- h 2)                      :color back-color                     :size #@(70 25))   (make-editable-text (if (not (w!-p (first data))) (format nil "~S" (first data)) "") 90 h :color edit-color)   (make-editable-text (if (not (w!-p (second data))) (format nil "~S" (second data)) "") 140 h :color edit-color)   (make-editable-text (if (not (w!-p (third data))) (format nil "~S" (third data)) "") 190 h :color edit-color)   (make-editable-text (if (not (w!-p (fourth data))) (format nil "~S" (fourth data)) "") 240 h :color edit-color)   (make-editable-text (if (not (w!-p (fifth data))) (format nil "~S" (fifth data)) "") 290 h :color edit-color)   (make-editable-text (if (not (w!-p (sixth data))) (format nil "~S" (sixth data)) "") 340 h :color edit-color)   (make-editable-text (if (not (w!-p (seventh data))) (format nil "~S" (seventh data)) "") 390 h :color edit-color)   (make-editable-text (if (not (w!-p (eighth data))) (format nil "~S" (eighth data)) "") 440 h :color edit-color)   (make-editable-text (if (not (w!-p (ninth data))) (format nil "~S" (ninth data)) "") 490 h :color edit-color)))#|(make-bodypart-views "aa" 20 '(a b c d e f g h i j k l) :color 14671839)(make-bodypart-views "aa" 20 '(a b c d e f g h i j k l))(make-bodypart-views "aa" 20 :color 14671839)|#(defun make-bodypart-verrous (h &optional bolts)  (list   (make-check-box "Free" 85 h (when bolts (first bolts)))   (make-check-box "Free" 135 h (when bolts (second bolts)))   (make-check-box "Free" 185 h (when bolts (third bolts)))   (make-check-box "Free" 235 h (when bolts (fourth bolts)))   (make-check-box "Free" 285 h (when bolts (fifth bolts)))   (make-check-box "Free" 335 h (when bolts (sixth bolts)))   (make-check-box "Free" 385 h (when bolts (seventh bolts)))   (make-check-box "Free" 435 h (when bolts (eighth bolts)))   (make-check-box "Free" 485 h (when bolts (ninth bolts)))))#|(rts (make-dialog-item 'check-box-dialog-item #@(110 265) #@(70 16) "random" 'nil                                 :view-font '("Chicago" 0 :SRCCOPY )))(string (CHECK-BOX-CHECKED-P rts))|#(defvar *new-body-part* '())(defvar *wind-sit-back-color* 14592000)(defvar *wind-sit-edit-color* 14605000)(defvar *new-bodyparts-subviews* '())(defvar *new-bolt-bodypart-view* '())(defvar *new-situation-name-view* nil)(defvar *new-situation-field-names* '())(defvar *new-situation-ok-button* nil)(defvar *new-situation-cancel-button* nil)(defvar *new-comment-situation-name-view* nil)(defvar *new-bodypart-button* nil)(defun get-new-situation-param (&rest item)  (declare (ignore item))  (return-from-modal-dialog   (values (dialog-item-text *new-situation-name-view*)           (mapcar #'dialog-item-text                   *new-bodyparts-subviews*)           (mapcar #'CHECK-BOX-CHECKED-P                   *new-bolt-bodypart-view*))))(defun new-param-bodypart-view (body-parts)  (setf *new-bodyparts-subviews*        (fflat (mapcar #'(lambda (part)                           (make-bodypart-views                            part                            (+ 90 (* 50 (position part body-parts :test #'equalp)))                            nil                            :back-color *wind-sit-back-color*                            :edit-color *wind-sit-edit-color*))                       body-parts))))(defun set-param-bodypart-view (body-parts &key data)  (setf *new-bodyparts-subviews*        (fflat (mapcar #'(lambda (part d)                           (make-bodypart-views                            part                            (+ 90 (* 50 (position part body-parts :test #'equalp)))                            d                            :back-color *wind-sit-back-color*                            :edit-color *wind-sit-edit-color*))                       body-parts data))))(defun new-bolt-bodypart-view ()  (setf *new-bolt-bodypart-view*        (fflat (mapcar #'(lambda (part)                           (make-bodypart-verrous                            (+ 112 (* 50 (position part *new-body-part* :test #'equalp)))))                       *new-body-part*))))(defun set-bolt-bodypart-view (&key bolts)  (setf *new-bolt-bodypart-view*        (fflat (mapcar #'(lambda (part b)                           (make-bodypart-verrous                            (+ 112 (* 50 (position part *new-body-part* :test #'equalp)))                            b))                       *new-body-part* (split-list-modulo bolts (1- *body-part-data-length*))))))(defun new-comment-situation-name-view ()  (setf *new-comment-situation-name-view*        (make-dialog-item 'static-text-dialog-item                           #@(175 9)                           #@(250 16)                          "new situation name :"                          'nil                          :view-font '("Helvetica" 14 :srcor :plain)                          ;:part-color-list (list :body *wind-sit-back-color*)                          )))(defun get-new-situation-name (&key name)  (setf *new-situation-name-view*        (make-dialog-item 'editable-text-dialog-item                          #@(180 30)                           #@(200 21)                           (if name name "SITUATION")                          'nil                          :view-font '("Helvetica" 16 :srcor :bold)                          ;:part-color-list (list :body *wind-sit-back-color*)                          )))(defun new-situation-cancel-button ()  (setf *new-situation-cancel-button*        (make-dialog-item  'button-dialog-item                           #@(10 10)                           #@(72 25)                          "cancel"                           #'(lambda (item) (declare (ignore item))                             (return-from-modal-dialog (format t "Cancelled.~%")))                          ))  (set-view-position *new-situation-cancel-button* 10 (+ 90 (* 50 (length *new-body-part*))))  (set-dialog-item-action-function *new-situation-cancel-button*                                 #'(lambda (item)                                     (window-close (view-window (view-container item)))))  )(defun new-situation-ok-button ()  (setf *new-situation-ok-button*        (make-instance 'button-dialog-item          :view-size #@(72 25)           :dialog-item-text "OK"          :dialog-item-enabled-p t          :dialog-item-action 'get-new-situation-param          :default-button t))  (set-view-position *new-situation-ok-button* 480 (+ 90 (* 50 (length *new-body-part*)) ))  (set-dialog-item-action-function *new-situation-ok-button*                                   #'(lambda (item)                                       (window-close (view-window (view-container item)))                                       (get-new-situation-param))                                   ))(defun add-new-bodypart (item)   (let* ((added-body-parts (set-bodyparts))          (emptydata-for-add-bp (loop for i from 1 to (length added-body-parts)                                      collect (make-list *body-part-data-length* :initial-element nil))))     (get-new-situation-name :name (dialog-item-text *new-situation-name-view*))  ;;take current name of situation in window     (setf *new-body-part* (append *new-body-part* added-body-parts))  ;;actualize bodyparts names variable of current situation     (set-param-bodypart-view *new-body-part*                               :data (append (mapcar #'cdr (split-list-modulo                                                           (mapcar #'(lambda (a)                                                                       (read-from-string (dialog-item-text a) nil))                                                                   *new-bodyparts-subviews*)                                                           *body-part-data-length*))                                            emptydata-for-add-bp))     (set-bolt-bodypart-view       :bolts (append              (mapcar #'CHECK-BOX-CHECKED-P *new-bolt-bodypart-view*)              (make-list (* 9 (length added-body-parts)) :initial-element nil)))          (set-view-position *new-situation-cancel-button*                        10 (+ 90 (* 50 (length *new-body-part*))))     (set-view-position *new-situation-ok-button*                        480 (+ 90 (* 50 (length *new-body-part*))))     (set-view-position *new-bodypart-button*                        200 (+ 90 (* 50 (length *new-body-part*))))     (set-view-size (view-container item)                    580                    (if (< (length *new-body-part*) 6)                      (+ 140 (* 50 (length *new-body-part*)))                      600))     (view-draw-contents (view-container item))))(defun new-bodypart-button ()  (setf *new-bodypart-button*        (make-instance 'button-dialog-item          :view-size #@(160 25)           :dialog-item-text "add a new body part"          :dialog-item-enabled-p t          :dialog-item-action 'add-new-bodypart          :default-button nil))  (set-view-position *new-bodypart-button* 200 (+ 90 (* 50 (length *new-body-part*)) ))  (set-dialog-item-action-function *new-bodypart-button*                                   'add-new-bodypart))(defun new-situation-field-names ()  (setf *new-situation-field-names*        (list         (make-static-text "Supp." 90 63 :color *wind-sit-back-color*)         (make-static-text "Elev." 140 63 :color *wind-sit-back-color*)         (make-static-text "Dir." 190 63 :color *wind-sit-back-color*)         (make-static-text "Rot." 240 63 :color *wind-sit-back-color*)         (make-static-text "Dis." 290 63 :color *wind-sit-back-color*)         (make-static-text "Flex." 340 63 :color *wind-sit-back-color*)         (make-static-text "Curv." 390 63 :color *wind-sit-back-color*)         (make-static-text "Con." 440 63 :color *wind-sit-back-color*)         (make-static-text "Adr." 490 63 :color *wind-sit-back-color* :size #@(45 16)))))(defclass new-situation-scrolling-window-scroller (scroller) ()  (:default-initargs    :field-size #@(220 220)))(defmethod view-draw-contents ((self new-situation-scrolling-window-scroller))    (call-next-method))#|(defmethod view-draw-contents ((self new-situation-scrolling-window-scroller))  (apply #'add-subviews (append (list self)                                                                *new-bodyparts-subviews*                                *new-bolt-bodypart-view*                                (list                                 *sit-menu-bar*                                 *new-situation-name-view*                                 *new-situation-ok-button*                                 *new-bodypart-button*                                 *new-situation-cancel-button*                                 *new-comment-situation-name-view*                                 )                                *new-situation-field-names*                                ))  (call-next-method))|#(defmethod scroll-bar-limits ((view new-situation-scrolling-window-scroller))  (normal-scroll-bar-limits view 560 (+ 120 (* 50 (length *new-body-part*)))))(defun get-pos-param (body-parts)  (setf *new-body-part* body-parts)  (NEW-PARAM-BODYPART-VIEW body-parts)  (mapcar #'funcall '(;situation-menu-bar                      NEW-BOLT-BODYPART-VIEW                      NEW-COMMENT-SITUATION-NAME-VIEW                      GET-NEW-SITUATION-NAME                      NEW-SITUATION-CANCEL-BUTTON                      new-bodypart-button                      NEW-SITUATION-OK-BUTTON                      NEW-SITUATION-FIELD-NAMES))  (let ((win (make-instance 'ccl::scrolling-window               :scroller-class 'new-situation-scrolling-window-scroller               :window-type :document-with-grow               :auto-position :centerMainScreen               :window-title "Define a new situation"               :view-size (make-point 580 (if (< (length *new-body-part*) 6)                                            (+ 140 (* 50 (length *new-body-part*)))                                            600))               :track-thumb-p t)))    (modal-dialog win)))#|(get-pos-param '("aa" "bb" "cc" "d" "e" "f" "g" "h" "i" "j" "k" "l" "m" "n" "o" "p" "q"))(get-pos-param '("aa" "bb" "cc" "d"))(new-situation)|#(defun new-situation (&optional verbose)  (let ((body-parts (set-bodyparts))         (body '())         (supp '())         (dir '())         (levels '())         (rot '())         (dist '()) (flex '()) (curv '()) (contacts '()) (addresss '()))    (when (not body-parts)      (lol-error-msg (format nil "Warning : there is no body part specified.~%Please enter body parts.")                     :size #@(300 100)                     :form 'new-situation))    (multiple-value-bind (name parameters freedoms)                         (GET-POS-PARAM (mapcar #'string body-parts))      (nsubstitute "W!" "" parameters :test #'equalp)      (dotimes (n (/ (length parameters) *body-part-data-length*))        (let ((a (nth (+ 0 (* 10 n)) parameters))              (b (nth (+ 1 (* 10 n) ) parameters))              (c (nth (+ 2 (* 10 n) ) parameters))              (d (nth (+ 3 (* 10 n) ) parameters))              (e (nth (+ 4 (* 10 n) ) parameters))              (f (nth (+ 5 (* 10 n) ) parameters))              (g (nth (+ 6 (* 10 n) ) parameters))              (h (nth (+ 7 (* 10 n) ) parameters))              (i (nth (+ 8 (* 10 n) ) parameters))              (j (nth (+ 9 (* 10 n) ) parameters)))          (push a  body)          (push (read-from-string b) supp)          (push (read-from-string c) levels)          (push (read-from-string d) dir)          (push (read-from-string e) rot)          (push (read-from-string f) dist)          (push (read-from-string g) flex)          (push (read-from-string h) curv)          (push (read-from-string i) contacts)          (push (read-from-string j) addresss)))            (let ((frees (split-list-modulo freedoms (1- *body-part-data-length*))))        (make-instance 'situation           :name (read-from-string name)         :body (reverse body)         :support (reverse supp)         :direction (reverse dir)         :level (reverse levels)         :rotation (reverse rot)         :distance (reverse dist)         :flexion (reverse flex)         :curve (reverse curv)         :contact (reverse contacts)         :address (reverse addresss)         :support-freedom (mapcar #'first frees)         :direction-freedom (mapcar #'third frees)         :level-freedom (mapcar #'second frees)         :rotation-freedom (mapcar #'fourth frees)         :distance-freedom (mapcar #'fifth frees)         :flexion-freedom (mapcar #'sixth frees)         :curve-freedom (mapcar #'seventh frees)         :contact-freedom (mapcar #'eighth frees)         :address-freedom (mapcar #'ninth frees)         :verbose verbose         :return t         ))      )))   #|(set-default-values 'all)(new-situation)(inspect SITUATION-7229)(full-jam SITUATION)(edit H)|#(defclass edit-situation-scrolling-window-scroller (scroller) ()  (:default-initargs    :field-size #@(220 220)))(defmethod scroll-bar-limits ((view edit-situation-scrolling-window-scroller))  (normal-scroll-bar-limits view 560 (+ 120 (* 50 (length *new-body-part*)))))(defmethod view-draw-contents ((self edit-situation-scrolling-window-scroller))  (apply #'add-subviews (append (list self)                                *sit-menu-bar*                                *new-bodyparts-subviews*                                *new-bolt-bodypart-view*                                (list                                 *new-situation-name-view*                                 *new-situation-ok-button*                                 *new-bodypart-button*                                 *new-situation-cancel-button*                                 *new-comment-situation-name-view*                                 )                                *new-situation-field-names*                                ))  (call-next-method))(defmethod edit-situation-window ((object situation))   (let ((data (mat-trans (mapcar #'(lambda  (n)                                      (funcall n object))                                  '(support level direction rotation distance flexion curve contact address))))         (bolts (apply #'append (mat-trans (mapcar #'(lambda  (n)                                                       (funcall (read-from-string (concatenate 'string (string n) "-freedom"))                                                                object))                                                     '(support level direction rotation distance flexion curve contact address))))))     (setf *new-body-part* (situation-body object))     (set-param-bodypart-view *new-body-part* :data data)     (set-bolt-bodypart-view :bolts bolts)     (GET-NEW-SITUATION-NAME :name (string (situation-name object)))     (mapcar #'funcall '(NEW-COMMENT-SITUATION-NAME-VIEW                         NEW-SITUATION-CANCEL-BUTTON                         new-bodypart-button                         NEW-SITUATION-OK-BUTTON                         NEW-SITUATION-FIELD-NAMES))     (let ((win (make-instance 'ccl::scrolling-window                  :scroller-class 'edit-situation-scrolling-window-scroller                  :window-type :document-with-grow                  :auto-position :centerMainScreen                  :window-title (concatenate 'string "Editing situation " (string (situation-name object)))                  :view-size (make-point 580 (if (< (length *new-body-part*) 6)                                               (+ 140 (* 50 (length *new-body-part*)))                                               600))                  :track-thumb-p t)))       (modal-dialog win))))#|(edit-situation-window situation1)|##|(new-situation)(edit c)(setq SITUATION-1764 za)SITUATION-1764(inspect c)(inspect SITUATION-7382)(situation-name SITUATION-1764)|#