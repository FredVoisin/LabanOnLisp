(defmethod view-draw-contents ((self situation-window))   (when (dimension-list (situation self))     (loop for v in (coerce (view-subviews self) 'list)           do                      (cond ((eq (find-class 'moving-dimension-text-view) (class-of v))                  (set-view-position v (+ 140 (* 70 (position (view-nick-name v)                                                              (dimension-list (situation self))                                                              :test #'equalp) ))                                     65))                 ((eq (find-class 'moving-bodypart-text-view) (class-of v))                  (set-view-position v                                     10                                     (+ 80 (* (+ 20 (font-line-height '("Monaco" 10)))                                              (position (view-nick-name v)                                                        (mapcar #'(lambda (x) (read-from-string (name x)))                                                                (body (situation self))))))))                 (t nil))))      (call-next-method))(make-instance 'situation-window  :window-type :document-with-grow  :situation a)(inspect a)