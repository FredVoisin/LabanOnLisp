subseq list n (length list))))(defmethod remove-n ((n list) (list t))  (setf n (sort n '>))  (if (null n)    list    (remove-n (cdr n) (remove-n (car n) list))))#|(remove-n 3 '(1 2 3 4 5 6 7 8 9))(remove-n '(3 7 9) '(1 2 3 4 5 6 7 8 3 9))|#(defun seqstring-to-liststrings (string)"Converts a string into a list of strings - words - separated by space character."  (let ((listofstrings ()) (lengths (pos-to-lengths (posofspaces string)))        (pos (append (list 0) (mapcar #'(lambda (x) (1+ x)) (butlast (posofspaces string))))))    (dotimes (l (length lengths) (nreverse listofstrings))      (let ((str (make-string (nth l lengths) :initial-element #\Space)))       (dotimes (n (nth l lengths) (push str listofstrings))         (setf (elt str n) (elt string (+ n (nth l pos)))))))))(defun posofspaces (string)  (let ((pos ()))    (dotimes (n (length string) (nreverse (append (list (length string)) pos)))      (when (equal (elt string n) #\Space)        (push n pos)))))(defun pos-to-lengths (positions)  (let ((lengths ()))    (dotimes (n (1- (length positions))                (append (list (car positions)) (nreverse lengths)))      (push (- (nth (1+ n) positions) (nth n positions) 1) lengths))))#|(seqstring-to-liststrings "ab cd efg")|#(defun set-bodyparts ()  (seqstring-to-liststrings   (get-string-from-user "Please, enter your Body Parts."                         :size #@(400 100)                         :position :centered                         :window-title "SET BODY PARTS")))(defclass moving-static-lol-text-view (moving-static-text-view)  ())(defmethod make-static-text ((text string) (h integer) (v integer) &key color size moving)  (let ((view (make-dialog-item 'static-text-dialog-item                                 #@(3 9)                                 (if size size #@(90 16))                                text                                'nil                                :part-color-list (if color 