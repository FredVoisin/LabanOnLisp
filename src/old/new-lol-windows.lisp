list view))))))    (if r r (values))))(defmethod find-view ((self list) (dimension t))  (let (r)    (loop for view in self          do          (when (lol-data-dialog-item-p view)            (when (equalp dimension (dimension view))              (setf r (append r (list view))))))    (if r r (values))))(defmethod find-view ((self main-situation-window) (dimension t))  (find-view (view-subviews self) dimension))(defmethod find-view ((self situation) (dimension t))  (find-view (window self) dimension));(find-view situation :support)(defun find-view1 (list class)  "REDEFINE FIND_VIEW IN THAT WAY....!!!!"  (loop for view in (coerce list 'list)        when (eq (class-of view) (find-class class))        collect view))(defmethod get-edited-data ((self situation) &rest dimensions)   (when (not dimensions) (setf dimensions *LABAN-DIMENSIONS*))   (loop for dim in dimensions         collect (mapcar #'(lambda (d) (read-from-string (dialog-item-text d) nil nil))                         (find-view self (make-keyword dim)))));(get-edited-data situation 'support 'level);(get-edited-data situation-1057)(defmethod record-edited-data ((self situation))   (loop for dim in (append *LABAN-DIMENSIONS* (other-dimensions self))         do         (when dim           (setf (slot-value self (quote dim))                 (mapcar #'(lambda (d) (read-from-string (dialog-item-text d) nil nil))                         (find-view self (make-keyword dim))))))   (values))(defmethod record-edited-data ((self main-situation-window))   (loop for dim in (append *LABAN-DIMENSIONS* (other-dimensions (eval (situation self))))         do         (when dim           (setf (slot-value (eval (situation self)) (symbol dim))                 (mapcar #'(lambda (d) (read-from-string (dialog-item-text d) nil nil))                         (find-view self dim)))))  (values))  