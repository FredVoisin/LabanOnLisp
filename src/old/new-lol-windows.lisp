mbda (txt x y) (make-editable-text txt x y :color color :object object :dimension dimension :size size)) text h v))(defmethod make-editable-text ((text list) (h list) (v integer) &key color object dimension size)  (mapcar #'(lambda (txt x) (make-editable-text txt x v :color color :object object :dimension dimension :size size)) text h))(defun make-check-box (text h v &optional checked)  (let ((chekbox  (make-dialog-item 'check-box-dialog-item                                    #@(3 3)                                    #@(40 12)                                    text                                    'nil                                    :check-box-checked-p checked                                    :view-font '("Chicago" 10 :SRCCOPY))))        (set-view-position chekbox h v)    chekbox))(defun make-bodypart-views (body-part h &optional data &key back-color edit-color)  (list   (make-static-text body-part 10 (- h 2)                      :color back-color                     :size #@(70 25))   (make-editable-text (if (not (w!-p (first data))) (format nil "~S" (first data)) "") 90 h :color edit-color :object body-part :dimension :support)   (make-editable-text (if (not (w!-p (second data))) (format nil "~S" (second data)) "") 140 h :color edit-color :object body-part :dimension :level)   (make-editable-text (if (not (w!-p (third data))) (format nil "~S" (third data)) "") 190 h :color edit-color :object body-part :dimension :direction)   (make-editable-text (if (not (w!-p (fourth data))) (format nil "~S" (fourth data)) "") 240 h :color edit-color :object body-part :dimension :rotation)   (make-editable-text (if (not (w!-p (fifth data))) (format nil "~S" (fifth data)) "") 290 h :color edit-color :object body-part :dimension :distance)   (make-editable-text (if (not (w!-p (sixth data))) (format nil "~S" (sixth data)) "") 340 h :color edit-color :object body-part :dimension :flexion)   (make-editable-text (if (not (w!-p (seventh data))) (format nil "~S" (seventh data)) "") 390 h :color edit-color :object body-part :dimension :curve)   (make-editable-text (if (not (w!-p (eighth data))) (format nil "~S" (eighth data)) "") 440 h :color edit-color :object body-part :dimension :contact)   (make-editable-text (if (not (w!-p (ninth data))) (format nil "~S" (ninth data)) "") 490 h :color edit-color :object body-part :dimension :address)))#|(make-bodypart-views "aa" 20 '(a b c d e f g h i j k l) :color 14671839)(make-bodypart-views "aa" 20 '(a b c d e f g h i j k l))(make-bodypart-views "aa" 20 :color 14671839)|#(defun make-bodypart-verrous (h &optional bolts)  (list   (make-check-box "Free" 85 h (when bolts (first bolts)))   (make-check-box "Free" 135 h (when bolts (second bolts)))   (make-check-box "Free" 185 h (when bolts (third bolts)))   (make-check-box "Free" 235 h (when bolts (fourth bolts)))   (make-check-box "Free" 285 h (when bolts (fifth bolts)))   (make-check-box "Free" 335 h (when bolts (sixth bolts)))   (make-check-box "Free" 385 h (when bolts (seventh bolts)))   (make-check-box "Free" 435 h (when bolts (eighth bolts)))   (make-check-box "Free" 485 h (when bolts (ninth bolts)))))#|(rts (make-dialog-item 'check-box-dialog-item #@(110 265) #@(70 16) "random" 'nil                                 :view-font '("Chicago" 0 :SRCCOPY )))(string (CHECK-BOX-CHECKED-P rts))|#(defun get-new-situation-param (&rest item)  (declare (ignore item))  (return-from-modal-dialog   (values (dialog-item-text *new-situation-name-view*)           (mapcar #'dialog-item-text                   *new-bodyparts-subviews*)           (mapcar #'CHECK-BOX-CHECKED-P                   *new-bolt-bodypart-view*))))(defun param-bodypart-view (body-parts &optional situation)  (if body-parts    (fflat (list (mapcar #'(lambda (part)                       (make-bodypart-views                        (string (name part))                        (+ 90 (* 50 (position part (if situation (body situation) body-parts) :test #'equalp)))                        nil                        :back-color *wind-sit-back-color*                        :edit-color *wind-sit-edit-color*))                   body-parts)           (mapcar #'(lambda (part)                       (make-bodypart-verrous                                                (+ 113 (* 50 (position part (if situation (body situation) body-parts) :test #'equalp)))                        nil))                   body-parts)))    (values)));(param-bodypart-view (list (make-instance 'bodypart)));(param-bodypart-view nil)(defun bolt-bodypart-view (window)  (fflat (mapcar #'(lambda (part)                           (make-bodypart-verrous                            (+ 112 (* 50 (position part *new-body-part* :test #'equalp)))))                       *new-body-part*)))(defun new-situation-ok-button ()  (let ((ok         (make-instance 'button-dialog-item           :view-size #@(72 25)            :dialog-item-text "OK"           :dialog-item-enabled-p t           :dialog-item-action 'get-new-situation-param           :default-button t)))  (set-view-position ok 480 (+ 90 (* 50 (length (body (situation view)))) ))  (set-dialog-item-action-function ok                                   #'(lambda (item)                                       (window-hide (view-window (view-container item)))                                       (get-new-situation-param))                                   )))(defun set-param-bodypart-view (body-parts &key data)  (fflat (mapcar #'(lambda (part d)                     (make-bodypart-views                      part                      (+ 90 (* 50 (position part body-parts :test #'equalp)))                      d                      :back-color *wind-sit-back-color*                      :edit-color *wind-sit-edit-color*))                 body-parts data)))(defun situation-field-names ()  (list   (make-static-text "Supp." 90 63 :color *wind-sit-b