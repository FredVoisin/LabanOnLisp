(in-package :lol)(require :scrolling-windows)(require :quickdraw)(require :dynamic-views)(defun lol-error-msg (text &key size position end-text form)  (when (not size)    (setf size #@(250 75)))  (when (not end-text)    (setf end-text "Aborted"))  (if position    (message-dialog text :size size :position position)    (message-dialog text :size size))  (catch-cancel (format *standard-output* "~%~S~%" end-text)                (if form (funcall form) (abort))))(defun choose-LOL-body-part ()  (select-item-from-list (subdivise 'bodypart)                       :window-title "Body Parts"                       :selection-type :disjoint));(choose-LOL-body-part); a "menubar" in a dialog(defclass situation-menubar (inspector::bottom-line-mixin view) ()); This draws the cool little black crescent-shaped fillet in the ; upper-left corner of the pseudo-menubar.;;(defmethod view-draw-contents ((view situation-menubar));  (call-next-method))(defmethod view-default-size ((view situation-menubar))  (let ((container (view-container view)))            (when container             (make-point (point-h (view-size container))                  (+ (ccl::view-font-line-height view) 4)))))(defmethod install-view-in-window ((view situation-menubar) w)  (declare (ignore w))  (multiple-value-bind (ff ms)(view-font-codes view)    (let ((container (view-container view)))      (when ff        (do-subviews (sub view)          (set-view-font-codes sub ff ms)))      ; sets slots      (ccl::set-default-size-and-position view container)      (call-next-method)      (invalidate-view view))))(defclass situation-window-scroller (scroller) ()  (:default-initargs    :field-size #@(220 220)))(defclass situation-window (ccl::scrolling-window dynamic-views-dialog)  ((situation :initarg :situation :initform nil :accessor situation :initarg :situation)   (restaure :initarg :restaure :initform nil :accessor restaure :initarg :restaure)   )  (:default-initargs    :color-p t    :view-size #@(560 100)    ;:back-color *wind-sit-back-color*    :scroller-class 'situation-window-scroller    :window-type :document-with-grow    :auto-position :centerMainScreen    :track-thumb-p t    :window-show nil    :close-box-p t)  (:documentation "Class of situation windows"));(defmethod view-draw-contents ((self situation-window));   (call-next-method));;*****;(defmethod install-new-body-part ((self situation));   (view-draw-contents (window self));   (invalidate-view (window self)))(defmethod scroll-bar-limits ((self situation-window))  (normal-scroll-bar-limits self 560 (+ 120 (* 50 (length (body (situation self)))))))(defmethod initialize-instance :after ((self situation-window)                                       &key situation)  (let* ((actual-situation (if situation situation (make-instance 'situation)))         (name (if situation (name situation) "SITUATION"))                  (name-view (make-dialog-item 'editable-text-dialog-item                                      #@(210 30)                                       #@(200 21)                                       name                                      'nil                                      :view-font '("Helvetica" 16 :srcor :bold)                                      ;:part-color-list (list :body *wind-sit-back-color*)                                      ))         (part-views (param-bodypart-view (body (eval (situation self))))))    (apply #'add-subviews (append (list self situation-menubar name-view)                                  part-views (situation-field-names)))                                                     (set-window-title self (concatenate 'string "situation : " name))    (setf (situation self) situation)    (window-select self)    ))#|:view-size (make-point 580 (if (< (length *new-body-part*) 6)                                            (+ 140 (* 50 (length *  new-body-part*)))                     